# ============================================================
# Auth service — переменные окружения (DEV)
#
# Использование:
#   cp .env.example .env
#
# Файл читает Makefile (make run, make migrate-*) для локального
# запуска бинарника на хосте.
# ============================================================

# ---- Приложение ----
PORT=8081
LOG_LEVEL=info

# ---- JWT ----
# Общий секрет с notifier — им notifier будет проверять подпись токена.
# Обязательно смените в проде и держите в синхроне с JWT_SECRET
# в .env notifier'а (см. корневой .env.example).
JWT_SECRET=devsecret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ---- Notifier (gRPC) ----
# Адрес gRPC-сервера notifier, на который auth отправляет уведомление
# при регистрации нового пользователя (see AuthService.Register).
# localhost:9090 — для make run на хосте, когда notifier поднят через
# docker compose (см. NOTIFIER_GRPC_HOST_PORT в корневом .env.example)
# или тоже запущен локально. Недоступность notifier не блокирует
# регистрацию — ошибка только логируется.
NOTIFIER_GRPC_ADDR=localhost:9090

# ---- Postgres ----
# make run стучится в Postgres на хосте. Если используете тот же
# Postgres-контейнер, что и notifier (localhost:5432) — создайте
# отдельную базу: `CREATE DATABASE auth;`
PG_HOST=localhost
PG_PORT=5432
PG_USER=auth
PG_PASSWORD=auth
PG_DBNAME=auth
PG_SSLMODE=disable
