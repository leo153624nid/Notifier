# ============================================================
# Notifier — переменные окружения (DEV)
#
# Использование:
#   cp .env.example .env
#
# Этот файл — единственный источник настроек и для локального
# запуска (`make run`), и для docker compose (`make docker-up`
# и т.д.). Значения читает Makefile и прокидывает их дальше.
#
# Для прод-окружения используйте .env.prod (см. .env.prod.example).
# ============================================================

# ---- Приложение ----
PORT=8080
GRPC_PORT=9090
LOG_LEVEL=info

# ---- JWT ----
# Общий секрет с auth-сервисом — notifier им проверяет подпись токена,
# который выдаёт auth. Должен совпадать с JWT_SECRET в services/auth/.env.
JWT_SECRET=devsecret

# ---- Порты, публикуемые на хосте (используются только docker compose) ----
APP_HOST_PORT=8080
# gRPC-порт notifier: NOTIFIER_GRPC_PORT — порт внутри контейнера/сети
# (его же auth находит как notifier:$NOTIFIER_GRPC_PORT, см. docker-compose.yml),
# NOTIFIER_GRPC_HOST_PORT — на какой порт хоста он пробрасывается наружу
# (удобно для локальной проверки через grpcurl).
NOTIFIER_GRPC_PORT=9090
NOTIFIER_GRPC_HOST_PORT=9090
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092

# ---- Auth-сервис (используются только docker compose) ----
AUTH_PORT=8081
AUTH_LOG_LEVEL=info
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
AUTH_APP_HOST_PORT=8081
AUTH_POSTGRES_HOST_PORT=5433
AUTH_PG_USER=auth
AUTH_PG_PASSWORD=auth
AUTH_PG_DBNAME=auth
AUTH_PG_SSLMODE=disable

# ---- Postgres ----
# PG_HOST/PG_PORT нужны для `make run` — бинарник запускается на хосте
# и стучится в Postgres через порт, опубликованный docker compose
# (POSTGRES_HOST_PORT), поэтому здесь localhost.
#
# Внутри docker-сети (когда notifier тоже запущен в контейнере) адрес
# БД всегда postgres:5432 — это задано в docker-compose.yml как топология
# сети и не зависит от этих переменных.
PG_HOST=localhost
PG_PORT=5432
PG_USER=notifier
PG_PASSWORD=notifier
PG_DBNAME=notifier
PG_SSLMODE=disable

# ---- Redis ----
RD_HOST=localhost
RD_PORT=6379
RD_PASSWORD=notifier

# ---- Kafka ----
# Брокеры, из которых notifier читает событие "пользователь залогинился"
# (топик auth.user.logged_in, см. internal/transport/kafka/login_consumer.go).
# localhost:9092 — для `make run` на хосте, когда Kafka поднята через
# docker compose и пробрасывает порт наружу (KAFKA_HOST_PORT выше).
# Внутри docker-сети (когда notifier сам в контейнере) адрес всегда
# kafka:9092 — это задано в docker-compose.yml как топология сети.
KAFKA_BROKERS=localhost:9092

# Имена топика/consumer group и dead-letter топика ниже не обязательны —
# дефолты заданы константами в contracts/events/auth/v1/login.go
# (TopicUserLoggedIn, GroupIDLoginConsumer, TopicNotifierDLQ) и одинаковы
# для всех окружений. Переменные нужны только для переопределения, например
# для локальных экспериментов, не трогая общие топики. См. internal/config/
# kafkaConfig.go и internal/transport/kafka/login_consumer.go.
# KAFKA_LOGIN_TOPIC=auth.user.logged_in
# KAFKA_LOGIN_GROUP_ID=notifier-login-consumer
# KAFKA_DLQ_TOPIC=notifier.dlq