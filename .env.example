# ============================================================
# Notifier — переменные окружения (DEV)
#
# Использование:
#   cp .env.example .env
#
# Этот файл — единственный источник настроек и для локального
# запуска (`make run`), и для docker compose (`make docker-up`
# и т.д.). Значения читает Makefile и прокидывает их дальше.
#
# Для прод-окружения используйте .env.prod (см. .env.prod.example).
# ============================================================

# ---- Приложение ----
PORT=8080
LOG_LEVEL=info

# ---- JWT ----
# Общий секрет с auth-сервисом — notifier им проверяет подпись токена,
# который выдаёт auth. Должен совпадать с JWT_SECRET в services/auth/.env.
JWT_SECRET=devsecret

# ---- Порты, публикуемые на хосте (используются только docker compose) ----
APP_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---- Auth-сервис (используются только docker compose) ----
AUTH_PORT=8081
AUTH_LOG_LEVEL=info
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
AUTH_APP_HOST_PORT=8081
AUTH_POSTGRES_HOST_PORT=5433
AUTH_PG_USER=auth
AUTH_PG_PASSWORD=auth
AUTH_PG_DBNAME=auth
AUTH_PG_SSLMODE=disable

# ---- Postgres ----
# PG_HOST/PG_PORT нужны для `make run` — бинарник запускается на хосте
# и стучится в Postgres через порт, опубликованный docker compose
# (POSTGRES_HOST_PORT), поэтому здесь localhost.
#
# Внутри docker-сети (когда notifier тоже запущен в контейнере) адрес
# БД всегда postgres:5432 — это задано в docker-compose.yml как топология
# сети и не зависит от этих переменных.
PG_HOST=localhost
PG_PORT=5432
PG_USER=notifier
PG_PASSWORD=notifier
PG_DBNAME=notifier
PG_SSLMODE=disable

# ---- Redis ----
RD_HOST=localhost
RD_PORT=6379
RD_PASSWORD=notifier