# ============================================================
# Notifier — переменные окружения (PROD)
#
# Использование на боевом хосте:
#   cp .env.prod.example .env.prod
#   # заполнить реальными значениями ниже
#   make docker-up ENV_FILE=.env.prod
#
# .env.prod НЕ коммитится (см. .gitignore) — храните реальные
# секреты отдельно (secret-менеджер, CI/CD-переменные и т.п.),
# этот файл — только шаблон с описанием, какие переменные нужны.
# ============================================================

PORT=8080
LOG_LEVEL=warn

# Общий секрет с auth-сервисом (см. JWT_SECRET в services/auth/.env.prod) —
# notifier им проверяет подпись токенов, которые выдаёт auth.
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

APP_HOST_PORT=8080

# ---- Auth-сервис ----
AUTH_PORT=8081
AUTH_LOG_LEVEL=warn
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
AUTH_APP_HOST_PORT=8081
AUTH_PG_USER=auth
AUTH_PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_PG_DBNAME=auth
AUTH_PG_SSLMODE=disable

# В проде обычно порты Postgres и Redis наружу не публикуют вообще —
# либо уберите проброс портов у сервисов postgres/redis в
# docker-compose.yml, либо ограничьте доступ файрволом/security group.
# Redis дополнительно защищён паролем (RD_PASSWORD), но т.к. это просто
# кэш без ACL/TLS, открывать его порт в интернет всё равно не стоит.
# Если публикация всё же нужна (например, для админ-доступа с
# ограниченного IP):
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

PG_HOST=localhost
PG_PORT=5432
PG_USER=notifier
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_DBNAME=notifier
PG_SSLMODE=disable

# ---- Redis ----
# RD_HOST/RD_PORT нужны только для `make run` (бинарник на хосте, см.
# комментарий про PG_HOST выше) — внутри docker-сети адрес всегда
# redis:6379, это задано в docker-compose.yml как топология сети.
RD_HOST=localhost
RD_PORT=6379
RD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Kafka ----
# Как и Postgres/Redis выше, в проде порт Kafka наружу обычно не
# публикуют — уберите проброс порта у сервиса kafka в docker-compose.yml
# или ограничьте доступ файрволом/security group.
KAFKA_HOST_PORT=9092

# Имена топика/consumer group и dead-letter топика переопределяют дефолты
# из contracts/events/auth/v1/login.go. В норме не нужны: задавайте только
# если в проде должны использоваться другие имена, чем в contracts.
# KAFKA_LOGIN_TOPIC=auth.user.logged_in
# KAFKA_LOGIN_GROUP_ID=notifier-login-consumer
# KAFKA_DLQ_TOPIC=notifier.dlq
