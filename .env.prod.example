# ============================================================
# Notifier — переменные окружения (PROD)
#
# Использование на боевом хосте:
#   cp .env.prod.example .env.prod
#   # заполнить реальными значениями ниже
#   make docker-up ENV_FILE=.env.prod
#
# .env.prod НЕ коммитится (см. .gitignore) — храните реальные
# секреты отдельно (secret-менеджер, CI/CD-переменные и т.п.),
# этот файл — только шаблон с описанием, какие переменные нужны.
# ============================================================

PORT=8080
API_KEY=CHANGE_ME_STRONG_RANDOM_KEY
LOG_LEVEL=warn

APP_HOST_PORT=8080

# В проде обычно порт Postgres наружу не публикуют вообще —
# либо уберите проброс порта у сервиса postgres в docker-compose.yml,
# либо ограничьте доступ файрволом/security group. Если публикация
# всё же нужна (например, для админ-доступа с ограниченного IP):
POSTGRES_HOST_PORT=5432

PG_HOST=localhost
PG_PORT=5432
PG_USER=notifier
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_DBNAME=notifier
PG_SSLMODE=disable
